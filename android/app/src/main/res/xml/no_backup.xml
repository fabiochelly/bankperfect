<?xml version="1.0" encoding="utf-8"?>
<!-- Rien dans les sauvegardes Android : le fichier de comptes vit dans le cloud
     choisi par l'utilisateur, et ses réglages restent sur l'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
