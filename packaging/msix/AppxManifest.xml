<?xml version="1.0" encoding="utf-8"?>
<!--
  Paquet MSIX pour le Microsoft Store : le Store signe lui-même le paquet
  après certification (pas de certificat à acheter), ce qui le fait accepter
  par SmartScreen et Smart App Control.

  Les marqueurs @…@ sont remplis par release.yml :
  - @IDENTITY_NAME@, @PUBLISHER@, @PUBLISHER_DISPLAY_NAME@ : valeurs données
    par Partner Center (Gestion des produits > Identité du produit), dans les
    variables du dépôt MSIX_IDENTITY_NAME, MSIX_PUBLISHER et
    MSIX_PUBLISHER_DISPLAY_NAME ;
  - @VERSION@ : version de la release sur quatre nombres (9.11.2.0).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>BankPerfect</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="BankPerfect" Executable="bankperfect.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="BankPerfect"
        Description="Gestion de comptes bancaires personnels, rapide et moderne"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="bankperfect">
            <uap:DisplayName>Fichier de comptes BankPerfect</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.bp</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
